<%- include("../partials/head", { title: t("password.title") }) %>
<section class="content-page narrow">
  <h1><%= t("password.title") %></h1>
  <% if (done) { %>
    <p class="success"><%= t("password.saved") %></p>
    <p><a href="/compte"><u><%= t("account.title") %></u></a></p>
  <% } else { %>
    <p class="muted"><%= t("password.intro") %></p>
    <% if (error) { %><p class="error"><%= error %></p><% } %>
    <form method="post" action="/mon-mot-de-passe" class="stack">
      <label><%= t("password.current") %><input type="password" name="current" autocomplete="current-password"></label>
      <label><%= t("password.new") %><input type="password" name="password" required minlength="8" autocomplete="new-password"></label>
      <label><%= t("password.confirm") %><input type="password" name="password2" required minlength="8" autocomplete="new-password"></label>
      <p class="muted small"><%= t("signup.pwHint") %></p>
      <button class="btn btn-primary" type="submit"><%= t("password.submit") %></button>
    </form>
  <% } %>
</section>
<%- include("../partials/foot") %>
